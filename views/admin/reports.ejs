<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reported Posts</title>
    <link rel="stylesheet" href="/css/reports.css">
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div id="header-container"></div>
    <div class="container mt-5">
        <h1 class="text-center mb-4">Reported Posts</h1>
        <div class="row">
            <% reports.forEach(report => { %>
                <div class="col-md-12 mb-4">
                    <div class="card border-danger">
                        <div class="card-header bg-danger text-white">
                            <h5 class="mb-0"><%= report.topic %></h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <p><strong>Username:</strong> <%= report.username %></p>
                                    <p><strong>Email:</strong> <%= report.email %></p>
                                    <p><strong>Reason:</strong> <%= report.reason %></p>
                                    <p><strong>Reported At:</strong> <%= report.reportedAt.toLocaleString() %></p>
                                </div>
                                <div class="col-md-4 text-center">
                                    <img src="<%= report.photo %>" class="card-img" alt="Report Image">
                                </div>
                                <div class="col-md-4">
                                    <p><%= report.paragraph %></p>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer text-right">
                            <button class="btn btn-danger" data-toggle="modal" data-target="#deleteModal<%= report._id %>">
                                <i class="fas fa-trash-alt"></i> Delete
                            </button>
                            <button class="btn btn-secondary" onclick="ignoreReport('<%= report._id %>')">
                                <i class="fas fa-ban"></i> Ignore
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Delete Confirmation Modal -->
                <div class="modal fade" id="deleteModal<%= report._id %>" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                Are you sure you want to delete this report and the associated post?
                            </div>
                            <div class="modal-footer">
                                <form action="/admin/report/delete/<%= report._id %>" method="POST">
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
    <div id="footer-container"></div>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="/javascript/header.js"></script>
    <script src="/javascript/footer.js"></script>
    <script>
        function ignoreReport(reportId) {
            fetch(`/admin/report/ignore/${reportId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
            })
            .then(response => {
                if (response.ok) {
                    alert('Report ignored successfully.');
                    window.location.reload();
                } else {
                    alert('Failed to ignore report.');
                }
            })
            .catch(error => {
                console.error('Error ignoring report:', error);
                alert('Failed to ignore report: ' + error.message);
            });
        }
    </script>
</body>
</html>
